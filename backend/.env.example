# Copy to .env and fill in real values. Never commit .env.
# See ../plan/16-technical-architecture.md for the full stack rationale.

# --- Supabase (Postgres + Auth) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Used by the dashboard for auth token verification (anon key is safe client-side too)
SUPABASE_ANON_KEY=

# --- Anthropic (lesson plans, coaching tips, briefs, weekly summaries) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- WhatsApp provider ---
# Phase 1-2 (pilot): Twilio WhatsApp Sandbox. Phase 5 (scale): swap to Meta Cloud API.
# See plan/13-whatsapp-integration-workflow.md
WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Server ---
PORT=3000
TIMEZONE=Asia/Karachi
# Deployed dashboard origin (frontend service URL). Leave unset locally —
# cors() allows all origins when this isn't set.
FRONTEND_URL=

# --- Scheduling (matches plan/13: 4:50am send window ahead of the 5:00am promise) ---
# Only used if ENABLE_INTERNAL_CRON=true (see below). Ignored otherwise.
MORNING_CHECKIN_CRON=50 4 * * 1-5
EVENING_REFLECTION_CRON=55 13 * * 1-5

# In-process node-cron only works on a host that never sleeps. On a free
# host that spins down on idle (e.g. Render's free Web Service tier), leave
# this false and use the externally-triggered /internal/jobs/* endpoints
# instead — see .github/workflows/ and DEPLOYMENT.md.
ENABLE_INTERNAL_CRON=false
# Required whenever ENABLE_INTERNAL_CRON=false: shared secret the external
# scheduler sends as the X-Job-Secret header. Generate any long random string.
JOB_TRIGGER_SECRET=
