# Copy to .env and fill in real values. Never commit .env.
# See ../plan/16-technical-architecture.md for the full stack rationale.

# --- Supabase (Postgres + Auth) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Used by the dashboard for auth token verification (anon key is safe client-side too)
SUPABASE_ANON_KEY=

# --- Anthropic (lesson plans, coaching tips, briefs, weekly summaries) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- WhatsApp provider ---
# Phase 1-2 (pilot): Twilio WhatsApp Sandbox. Phase 5 (scale): swap to Meta Cloud API.
# See plan/13-whatsapp-integration-workflow.md
WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Server ---
PORT=3000
TIMEZONE=Asia/Karachi

# --- Scheduling (matches plan/13: 4:50am send window ahead of the 5:00am promise) ---
MORNING_CHECKIN_CRON=50 4 * * 1-5
EVENING_REFLECTION_CRON=55 13 * * 1-5
